# Allowed values: development | testing | staging | production
APP_ENV=development

APP_NAME=Communication Bridge AI
APP_VERSION=1.1.0
HOST=0.0.0.0
PORT=8000

# Use a persistent path in production, e.g. /app/data/communication_bridge.db
DATABASE_PATH=data/communication_bridge.db

# Gesture landmark dataset collection (labels are comma-separated lowercase snake_case).
GESTURE_DATASET_PATH=data/gesture_dataset_v1.jsonl
GESTURE_DATASET_LABELS=open_palm,fist,thumbs_up,wave,unknown
# Dynamic labels are stored as ordered landmark sequences; wave is dynamic by default.
GESTURE_DATASET_DYNAMIC_LABELS=wave
# Empty by default. Set comma-separated existing application user IDs to authorize collectors.
GESTURE_DATASET_COLLECTOR_IDS=

GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash-latest

# Optional when APP_ENV=development or APP_ENV=testing (a local-only default is used).
# Required when APP_ENV=staging or APP_ENV=production: set a strong random secret.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

LOG_LEVEL=INFO
DEFAULT_CONFIDENCE_THRESHOLD=0.7

# Comma-separated list
# For production, set only trusted public origins, e.g. https://bridge.slimeshustlers.com
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
